# Student Extension — server configuration (the Deploy Kit's whole
# configuration surface). Copy this file to `.env` in this folder and
# fill in the three values: docker compose reads `.env` automatically.
# All three are required — with any of them empty, sign-in stays
# disabled (the server fails closed, on purpose).

# Google OAuth2 client — create it in the Google Cloud Console
# (README § 1). Use the client's ID, e.g.
# 123456789012-abc123.apps.googleusercontent.com
SE_GOOGLE_CLIENT_ID=

# The same client's secret (shown once at creation; README § 1).
SE_GOOGLE_CLIENT_SECRET=

# Your school's Google Workspace domain — the part after the @.
# ONLY accounts whose email ends in this domain can sign in
# (students, teachers, everyone). e.g. your-school.sch.uk
SE_WORKSPACE_DOMAIN=

# SE_RUNNER_URL is deliberately NOT here: it defaults to the
# internal Docker network address of the runner sidecar and only
# matters in exotic setups. Leave it unset.
